{
  "productName": "ohmkit",
  "version": "0.1.0",
  "identifier": "com.ohmkit.tauri",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "ohmkit — 电阻工具箱",
        "width": 780,
        "height": 600,
        "resizable": true,
        "center": true
      }
    ]
  }
}
